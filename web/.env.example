# Copy to web/.env.local and fill in. The build fails if either value is missing: there is
# no default environment, so the site can never talk to the wrong Paddle account by accident.

# "sandbox" or "production". Selects the price IDs in src/config.ts (PADDLE_PRICE_IDS).
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client-side token from Paddle > Developer tools > Authentication.
# Sandbox tokens start with test_, live tokens with live_. Safe to expose in the browser.
# Never put an API key (pdl_...) in a NEXT_PUBLIC_ variable: those are shipped to the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_REPLACE_ME

# --- Server only (never NEXT_PUBLIC_, never in client code) ---

# Paddle API key (pdl_sdbx_apikey_... in sandbox, pdl_live_apikey_... in production), from
# Paddle > Developer tools > Authentication. Needs: customer.read, customer_portal_session.write.
PADDLE_API_KEY=

# Signing secret of the webhook notification destination (pdl_ntfset_...), from
# Paddle > Developer tools > Notifications. This is NOT the API key, and sandbox and
# production destinations each have their own.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Postgres connection string (Neon, Supabase, ...). Apply the schema once with
# `pnpm --filter @stowlet/web db:migrate`.
DATABASE_URL=

# Resend API key and the verified sender used for the license-key email.
RESEND_API_KEY=
LICENSE_EMAIL_FROM="Stowlet <licenses@stowlet.app>"
